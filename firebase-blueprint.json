{
  "entities": {
    "User": {
      "title": "User",
      "description": "Registered user record linked to Firebase Auth UID",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "firebase_uid": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "status": { "type": "string", "enum": ["ACTIVE", "SUSPENDED", "PENDING"] },
        "created_at": { "type": "string" },
        "updated_at": { "type": "string" }
      },
      "required": ["id", "firebase_uid", "email", "status"]
    },
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile with personal preferences and display info",
      "type": "object",
      "properties": {
        "user_id": { "type": "string" },
        "first_name": { "type": "string", "maxLength": 100 },
        "last_name": { "type": "string", "maxLength": 100 },
        "display_name": { "type": "string", "maxLength": 100 },
        "avatar_url": { "type": "string" },
        "country": { "type": "string", "maxLength": 10 },
        "language": { "type": "string", "maxLength": 10 },
        "currency": { "type": "string", "maxLength": 10 },
        "timezone": { "type": "string", "maxLength": 64 },
        "created_at": { "type": "string" },
        "updated_at": { "type": "string" }
      },
      "required": ["user_id"]
    },
    "Store": {
      "title": "Store",
      "description": "Merchant storefront on MARA",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "seller_id": { "type": "string" },
        "slug": { "type": "string", "pattern": "^[a-z0-9_-]+$" },
        "name": { "type": "string", "maxLength": 120 },
        "logo_url": { "type": "string" },
        "cover_url": { "type": "string" },
        "description": { "type": "string", "maxLength": 2000 },
        "status": { "type": "string", "enum": ["ACTIVE", "PAUSED", "PENDING"] },
        "rating": { "type": "number" },
        "reviews_count": { "type": "number" },
        "shipping_policies": { "type": "string" },
        "return_policies": { "type": "string" },
        "created_at": { "type": "string" },
        "updated_at": { "type": "string" }
      },
      "required": ["id", "seller_id", "slug", "name", "status"]
    },
    "Product": {
      "title": "Product",
      "description": "Product published by a merchant on MARA",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "store_id": { "type": "string" },
        "seller_id": { "type": "string" },
        "category_id": { "type": "string" },
        "title": { "type": "string", "maxLength": 200 },
        "slug": { "type": "string", "pattern": "^[a-z0-9_-]+$" },
        "description": { "type": "string", "maxLength": 10000 },
        "brand": { "type": "string", "maxLength": 100 },
        "condition": { "type": "string", "enum": ["NEW", "LIKE_NEW", "GOOD", "FAIR"] },
        "status": { "type": "string", "enum": ["DRAFT", "ACTIVE", "PAUSED", "OUT_OF_STOCK", "ARCHIVED"] },
        "price": { "type": "number" },
        "compare_at_price": { "type": "number" },
        "currency": { "type": "string", "maxLength": 10 },
        "stock": { "type": "number" },
        "images": { "type": "array" },
        "variants": { "type": "array" },
        "specifications": { "type": "object" },
        "dimensions": { "type": "string" },
        "weight": { "type": "string" },
        "shipping_method": { "type": "string" },
        "published_at": { "type": "string" },
        "created_at": { "type": "string" },
        "updated_at": { "type": "string" }
      },
      "required": ["id", "store_id", "seller_id", "title", "slug", "price", "stock", "status"]
    },
    "Order": {
      "title": "Order",
      "description": "Marketplace purchase order",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "order_number": { "type": "string" },
        "user_id": { "type": "string" },
        "seller_id": { "type": "string" },
        "store_id": { "type": "string" },
        "items": { "type": "array" },
        "subtotal": { "type": "number" },
        "shipping_fee": { "type": "number" },
        "tax": { "type": "number" },
        "total": { "type": "number" },
        "currency": { "type": "string" },
        "status": {
          "type": "string",
          "enum": ["PENDING", "PAYMENT_PROCESSING", "PAID", "PROCESSING", "SHIPPED", "DELIVERED", "CANCELLED", "REFUND_PENDING", "REFUNDED", "DISPUTED"]
        },
        "shipping_address": { "type": "object" },
        "delivery_method": { "type": "string" },
        "payment_status": { "type": "string" },
        "payment_method": { "type": "string" },
        "tracking_number": { "type": "string" },
        "carrier": { "type": "string" },
        "created_at": { "type": "string" },
        "updated_at": { "type": "string" }
      },
      "required": ["id", "order_number", "user_id", "seller_id", "items", "total", "status"]
    },
    "Review": {
      "title": "Review",
      "description": "Verified customer review for a product",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "product_id": { "type": "string" },
        "order_id": { "type": "string" },
        "user_id": { "type": "string" },
        "user_name": { "type": "string" },
        "rating": { "type": "number" },
        "comment": { "type": "string", "maxLength": 2000 },
        "verified_purchase": { "type": "boolean" },
        "created_at": { "type": "string" }
      },
      "required": ["id", "product_id", "user_id", "rating"]
    },
    "Conversation": {
      "title": "Conversation",
      "description": "Direct message thread between buyer and seller",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "participants": { "type": "array" },
        "order_id": { "type": "string" },
        "product_id": { "type": "string" },
        "last_message": { "type": "string" },
        "last_message_at": { "type": "string" },
        "created_at": { "type": "string" },
        "updated_at": { "type": "string" }
      },
      "required": ["id", "participants"]
    },
    "Message": {
      "title": "Message",
      "description": "Single message inside a conversation",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "conversation_id": { "type": "string" },
        "sender_id": { "type": "string" },
        "text": { "type": "string", "maxLength": 4000 },
        "attachment_url": { "type": "string" },
        "read": { "type": "boolean" },
        "created_at": { "type": "string" }
      },
      "required": ["id", "conversation_id", "sender_id", "text"]
    },
    "Notification": {
      "title": "Notification",
      "description": "System or transactional user notification",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "user_id": { "type": "string" },
        "type": { "type": "string" },
        "title": { "type": "string" },
        "message": { "type": "string" },
        "link": { "type": "string" },
        "read": { "type": "boolean" },
        "created_at": { "type": "string" }
      },
      "required": ["id", "user_id", "title", "message"]
    },
    "Category": {
      "title": "Category",
      "description": "Marketplace product category",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "parent_id": { "type": "string" },
        "name": { "type": "string" },
        "slug": { "type": "string" },
        "description": { "type": "string" },
        "image_url": { "type": "string" },
        "status": { "type": "string" },
        "sort_order": { "type": "number" }
      },
      "required": ["id", "name", "slug"]
    },
    "Wishlist": {
      "title": "Wishlist",
      "description": "User saved products",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "user_id": { "type": "string" },
        "product_ids": { "type": "array" },
        "updated_at": { "type": "string" }
      },
      "required": ["id", "user_id", "product_ids"]
    },
    "SellerBalance": {
      "title": "SellerBalance",
      "description": "Financial ledger balance for sellers",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "seller_id": { "type": "string" },
        "pending_amount": { "type": "number" },
        "available_amount": { "type": "number" },
        "withdrawn_amount": { "type": "number" },
        "currency": { "type": "string" },
        "updated_at": { "type": "string" }
      },
      "required": ["id", "seller_id", "currency"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "Base user record"
    },
    "/profiles/{userId}": {
      "schema": "UserProfile",
      "description": "User personal profile details"
    },
    "/stores/{storeId}": {
      "schema": "Store",
      "description": "Merchant storefronts"
    },
    "/products/{productId}": {
      "schema": "Product",
      "description": "Products for sale"
    },
    "/categories/{categoryId}": {
      "schema": "Category",
      "description": "Catalog categories"
    },
    "/orders/{orderId}": {
      "schema": "Order",
      "description": "Marketplace orders"
    },
    "/reviews/{reviewId}": {
      "schema": "Review",
      "description": "Product reviews"
    },
    "/conversations/{conversationId}": {
      "schema": "Conversation",
      "description": "Buyer-seller messaging threads"
    },
    "/conversations/{conversationId}/messages/{messageId}": {
      "schema": "Message",
      "description": "Messages inside conversation thread"
    },
    "/notifications/{notificationId}": {
      "schema": "Notification",
      "description": "User notifications"
    },
    "/wishlists/{userId}": {
      "schema": "Wishlist",
      "description": "User wishlist"
    },
    "/seller_balances/{sellerId}": {
      "schema": "SellerBalance",
      "description": "Seller revenue balance"
    }
  }
}
