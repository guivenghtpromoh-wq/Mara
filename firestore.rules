rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net: default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.admin == true ||
        request.auth.token.role == 'ADMIN' ||
        request.auth.token.role == 'SUPER_ADMIN' ||
        request.auth.token.email == 'michelguiveng@gmail.com'
      );
    }

    // 1. Users private data
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create, update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    // 2. User Profiles (Public read; Owner update except role)
    match /profiles/{userId} {
      allow read: if true;
      allow create: if isOwner(userId) || isAdmin();
      allow update: if (isOwner(userId) && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['user_id', 'role', 'isAdmin']))) || isAdmin();
      allow delete: if isAdmin();
    }

    // Private profile info (addresses, payment methods, PII)
    match /private_profiles/{userId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }

    // 3. Categories (Public read; Admin write)
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 4. Stores (Public read; Seller manage presentation fields)
    match /stores/{storeId} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.seller_id == request.auth.uid;
      allow update: if (isSignedIn() && resource.data.seller_id == request.auth.uid &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'seller_id',
          'verification_status',
          'rating',
          'reviews_count',
          'commission',
          'payout_status',
          'moderation_status',
          'created_at'
        ])) ||
        (isSignedIn() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rating', 'reviews_count', 'updated_at'])) ||
        isAdmin();
      allow delete: if isAdmin();
    }

    // 5. Products (Public read; Seller or Admin update)
    match /products/{productId} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.seller_id == request.auth.uid;
      allow update: if isSignedIn() && (
        (resource.data.seller_id == request.auth.uid &&
         !request.resource.data.diff(resource.data).affectedKeys().hasAny([
           'id',
           'seller_id',
           'store_id',
           'rating',
           'reviews_count',
           'sales_count',
           'verification',
           'moderation_status',
           'created_at'
         ])) ||
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stock', 'status', 'updated_at'])) ||
        isAdmin()
      );
      allow delete: if (isSignedIn() && resource.data.seller_id == request.auth.uid) || isAdmin();
    }

    // 6. Orders & Seller Orders
    match /orders/{orderId} {
      allow read: if isSignedIn() && (
        resource.data.user_id == request.auth.uid ||
        resource.data.seller_id == request.auth.uid ||
        isAdmin()
      );
      allow create: if isSignedIn() && request.resource.data.user_id == request.auth.uid;
      allow update: if isSignedIn() && (
        (resource.data.seller_id == request.auth.uid &&
         !request.resource.data.diff(resource.data).affectedKeys().hasAny(['total', 'subtotal', 'tax', 'shipping_fee', 'user_id', 'seller_id', 'items', 'created_at'])) ||
        isAdmin()
      );
      allow delete: if isAdmin();
    }

    match /seller_orders/{orderId} {
      allow read: if isSignedIn() && (
        resource.data.user_id == request.auth.uid ||
        resource.data.seller_id == request.auth.uid ||
        isAdmin()
      );
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (
        (resource.data.seller_id == request.auth.uid &&
         !request.resource.data.diff(resource.data).affectedKeys().hasAny(['total', 'subtotal', 'tax', 'shipping_fee', 'user_id', 'seller_id', 'items', 'created_at'])) ||
        isAdmin()
      );
      allow delete: if isAdmin();
    }

    match /marketplace_orders/{orderId} {
      allow read: if isSignedIn() && (resource.data.user_id == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && request.resource.data.user_id == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // 7. Payment Transactions
    match /payment_transactions/{txId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    // 8. Inventory Reservations
    match /inventory_reservations/{reservationId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    // 9. Reviews (Public read; Verified purchasers)
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.user_id == request.auth.uid;
      allow update: if isOwner(resource.data.user_id) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['product_id', 'order_id', 'user_id', 'verified_purchase', 'created_at']);
      allow delete: if isOwner(resource.data.user_id) || isAdmin();
    }

    // 10. Conversations & Messages
    match /conversations/{conversationId} {
      allow read: if isSignedIn() && (request.auth.uid in resource.data.participants || isAdmin());
      allow create: if isSignedIn() && (request.auth.uid in request.resource.data.participants);
      allow update: if isSignedIn() && (request.auth.uid in resource.data.participants) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['id', 'participants', 'order_id', 'created_at']);

      match /messages/{messageId} {
        allow read: if isSignedIn() && (
          request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants ||
          isAdmin()
        );
        allow create: if isSignedIn() &&
          request.resource.data.sender_id == request.auth.uid &&
          (request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants);
        allow update, delete: if isAdmin();
      }
    }

    // 11. Notifications
    match /notifications/{notificationId} {
      allow read: if isSignedIn() && resource.data.user_id == request.auth.uid;
      allow update: if isSignedIn() && resource.data.user_id == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'read_at']);
      allow create: if isSignedIn();
      allow delete: if isAdmin();
    }

    // 12. Wishlists
    match /wishlists/{userId} {
      allow read, write: if isOwner(userId);
    }

    // 13. Seller Balances & Financial Ledger
    match /seller_balances/{sellerId} {
      allow read: if isSignedIn() && (resource.data.seller_id == request.auth.uid || sellerId == request.auth.uid || isAdmin());
      allow write: if isSignedIn();
    }

    match /ledger_entries/{entryId} {
      allow read: if isSignedIn() && (resource.data.seller_id == request.auth.uid || isAdmin());
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    // 14. Payout Requests
    match /payout_requests/{payoutId} {
      allow read: if isSignedIn() && (resource.data.seller_id == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && request.resource.data.seller_id == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // 15. Disputes & Refunds
    match /disputes/{disputeId} {
      allow read: if isSignedIn() && (
        resource.data.buyer_id == request.auth.uid ||
        resource.data.seller_id == request.auth.uid ||
        isAdmin()
      );
      allow create: if isSignedIn() && request.resource.data.buyer_id == request.auth.uid;
      allow update: if isSignedIn() && (
        resource.data.buyer_id == request.auth.uid ||
        resource.data.seller_id == request.auth.uid ||
        isAdmin()
      );
      allow delete: if isAdmin();
    }

    match /refund_records/{refundId} {
      allow read: if isSignedIn() && (
        resource.data.buyer_id == request.auth.uid ||
        resource.data.seller_id == request.auth.uid ||
        isAdmin()
      );
      allow write: if isAdmin();
    }

    // 16. Moderation Reports
    match /moderation_reports/{reportId} {
      allow read: if isSignedIn() && (resource.data.reporter_id == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && request.resource.data.reporter_id == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // 17. Coupons & Promotions
    match /coupons/{couponId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 18. Configurations (Public read; Admin write)
    match /config_countries/{code} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /config_currencies/{code} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /config_taxes/{taxId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /config_commissions/{commId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /config_delivery/{delId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /config_payments/{payId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 19. Audit Logs (Admin read; Signed-in append)
    match /audit_logs/{logId} {
      allow read: if isAdmin();
      allow create: if isSignedIn();
      allow update, delete: if false; // Immutable logs
    }
  }
}
